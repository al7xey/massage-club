# Application
NODE_ENV=development
CLIENT_PORT=5173
SERVER_PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=massage_subscriptions
POSTGRES_USER=massage_app
POSTGRES_PASSWORD=massage_password
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# Auth
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
APP_ENCRYPTION_KEY=change_me_32_byte_minimum_encrypt_key
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:3000/api
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://relaxup.ru/api/auth/yandex/callback
REQUEST_RATE_LIMIT_WINDOW_MS=60000
REQUEST_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
TRUST_PROXY_HOPS=1
HSTS_MAX_AGE_SECONDS=15552000

# Docker
WEB_PORT=8080
DOCKER_NODE_ENV=docker
DOCKER_DATABASE_SYNCHRONIZE=true
SEED_DATABASE_SYNCHRONIZE=true
DOCKER_CORS_ORIGIN=https://relaxup.ru,https://www.relaxup.ru

# Cloudflare Tunnel
# In Cloudflare Zero Trust, route relaxup.ru and www.relaxup.ru to http://web:80.
CLOUDFLARE_TUNNEL_TOKEN=

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api
VITE_YANDEX_METRIKA_ID=
