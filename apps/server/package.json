{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build --workspace @massage/shared && nest build",
    "dev": "npm run build --workspace @massage/shared && nest start --watch",
    "start": "node dist/main.js",
    "start:dev": "npm run build --workspace @massage/shared && nest start --watch",
    "seed": "npm run build --workspace @massage/shared && ts-node -r tsconfig-paths/register src/database/seed.ts"
  },
  "dependencies": {
    "@massage/shared": "file:../../packages/shared",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/passport-jwt": "^4.0.1",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
